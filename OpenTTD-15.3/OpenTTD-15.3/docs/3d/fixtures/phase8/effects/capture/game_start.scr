setting gui.show_finances false
unpause
setting gui.fast_forward_speed_limit 2000
renderer_3d fastforward on
start_ai Effects3DFixture
renderer_3d on
renderer_3d verifydirty on
renderer_3d verifygpu on
scrollto instant 70 76
zoomto 0
renderer_3d camera 0 100
schedule on-next-calendar-month scripts/capture1.scr
